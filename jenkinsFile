pipeline {
    agent any

    environment {
        EC2_HOST = "13.234.17.129"
        EC2_USER = "ec2-user"
        APP_DIR  = "/home/ec2-user/server-be"
        PEM_PATH = "C:\\Users\\Asus\\.ssh\\be-prod.pem"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'master',
                    credentialsId: 'github-creds',
                    url: 'https://github.com/dev-akshaypatidar/server-be.git'
            }
        }

        stage('Install Dependencies (Jenkins)') {
            steps {
                bat 'npm install'
            }
        }

        stage('Deploy to EC2') {
            steps {
                bat """
                ssh -i "%PEM_PATH%" -o StrictHostKeyChecking=no %EC2_USER%@%EC2_HOST% ^
                "if [ ! -d ${APP_DIR} ]; then \
                    git clone https://github.com/dev-akshaypatidar/server-be.git ${APP_DIR}; \
                 fi; \
                 cd ${APP_DIR}; \
                 git pull origin master; \
                 npm install; \
                 pm2 restart server-be || pm2 start npm --name server-be -- start; \
                 pm2 save"
                """
            }
        }
    }

    post {
        success {
            echo "Deployment Successful ✅"
        }
        failure {
            echo "Deployment Failed ❌"
        }
    }
}