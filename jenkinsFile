pipeline {
    agent any

    environment {
        EC2_HOST = "13.234.17.129"
        EC2_USER = "ec2-user"
        APP_DIR  = "/home/ec2-user/server-be"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'master',
                    credentialsId: 'github-creds',
                    url: 'https://github.com/dev-akshaypatidar/server-be.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'npm install'
            }
        }

        stage('Deploy to EC2') {
            steps {
                sshagent(['ec2-ssh']) {
                    bat """
                        ssh -o StrictHostKeyChecking=no %EC2_USER%@%EC2_HOST% ^
                        "cd ${APP_DIR} || mkdir -p ${APP_DIR} && ^
                        cd ${APP_DIR} && ^
                        git pull origin master && ^
                        npm install && ^
                        pm2 restart server-be || pm2 start npm --name server-be -- start"
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Deployment Successful ✅"
        }
        failure {
            echo "Deployment Failed ❌"
        }
    }
}