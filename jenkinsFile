pipeline {
    agent any

    environment {
        EC2_HOST = "13.234.17.129"          // Your EC2 IP
        EC2_USER = "ec2-user"              // Change if Ubuntu -> ubuntu
        APP_DIR  = "/home/ec2-user/server-be"
    }

    tools {
        nodejs "NodeJS_18"                 // Must match Jenkins Global Tool name
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                    credentialsId: 'github-creds',
                    url: 'https://github.com/dev-akshaypatidar/server-be.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Build') {
            steps {
                sh 'npm run build || echo "No build script found"'
            }
        }

        stage('Deploy to EC2') {
            steps {
                sshagent(['ec2-ssh']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_HOST} '
                            if [ ! -d "${APP_DIR}" ]; then
                                git clone https://github.com/dev-akshaypatidar/server-be.git ${APP_DIR}
                            fi
                            
                            cd ${APP_DIR}
                            git pull origin main
                            npm install
                            
                            pm2 delete server-be || true
                            pm2 start npm --name "server-be" -- start
                            pm2 save
                        '
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Deployment Successful ✅"
        }
        failure {
            echo "Deployment Failed ❌"
        }
    }
}


